# Supabase Postgres + Storage — copy to apps/api/.env.supabase
# Run: pnpm dev:supabase
#
# Option A: full connection string (recommended)
# Find in Supabase Dashboard → Project Settings → Database → Connection string → URI
# Use "Session pooler" or "Direct connection" for local dev.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
#
# Option B: build URL from parts (DATABASE_URL takes precedence when set)
# SUPABASE_DB_HOST=db.[project-ref].supabase.co
# DATABASE_SUPABASE_PASSWORD=your-db-password
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres

ENABLE_DEV_TOOLS=true

# --- Supabase Storage (S3-compatible) ---
# Dashboard → Storage → S3 Configuration → create access key + copy region
# Create bucket "image-storage" (or match S3_BUCKET) before starting the API.
STORAGE_DRIVER=supabase
S3_BUCKET=image-storage
# Optional if DATABASE_URL contains your project ref; otherwise set explicitly:
# SUPABASE_PROJECT_REF=your-project-ref
# S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
S3_REGION=your-project-region
S3_ACCESS_KEY=your_s3_access_key_id
S3_SECRET_KEY=your_s3_secret_access_key

# CDN signed URLs — Project Settings → API → service_role key (server-only)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Leave false to keep bucket private; app-public images get signed CDN URLs via API
# SUPABASE_BUCKET_PUBLIC=true

HOST=127.0.0.1
PORT=8080
JWT_SECRET=dev-only-change-in-production
FRONTEND_URL=http://localhost:3000

# --- Auto-tag (optional, local Docker only — does not use Supabase) ---
# pnpm ollama:up && pnpm ollama:setup
# IMAGE_CLASSIFIER=ollama
# OLLAMA_URL=http://127.0.0.1:11435
# OLLAMA_MODEL=phototagger
# AUTO_TAG_ON_UPLOAD=true

