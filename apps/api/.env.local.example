# Local disk storage — copy to apps/api/.env.local
# Run: pnpm dev  (or pnpm dev:local)

ENABLE_DEV_TOOLS=true

STORAGE_DRIVER=local
STORAGE_PATH=data/storage

HOST=127.0.0.1
PORT=8080
JWT_SECRET=dev-only-change-in-production
FRONTEND_URL=http://localhost:3000
# SQLite fallback when DATABASE_URL is unset
DATABASE_PATH=data/app.db

# Auto-tag (requires: pnpm infra:up && pnpm ollama:setup)
# IMAGE_CLASSIFIER=ollama
# OLLAMA_URL=http://127.0.0.1:11435
# OLLAMA_MODEL=phototagger
# AUTO_TAG_ON_UPLOAD=true