# Use profile env files instead of a single .env:
#   apps/api/.env.local  → pnpm dev / pnpm dev:local  (local disk)
#   apps/api/.env.neon   → pnpm dev:neon             (Neon Object Storage)
# Copy from .env.local.example or .env.neon.example



HOST=127.0.0.1

PORT=8080

JWT_SECRET=change-me-in-production

MAX_UPLOAD_BYTES=20971520

FRONTEND_URL=http://localhost:3000



# --- Database ---

# SQLite (default when DATABASE_URL is unset)
DATABASE_PATH=data/app.db

# Supabase / Postgres — see apps/api/.env.supabase.example
# DATABASE_URL=postgresql://postgres.[ref]:[password]@....supabase.com:6543/postgres?sslmode=require



# --- Blob storage ---

# local (default) | neon | r2 | supabase | s3

STORAGE_DRIVER=local

STORAGE_PATH=data/storage



# --- Neon Object Storage (recommended — docs/neon-storage-setup.md) ---

# Copy apps/api/.env.neon.example for a full template.

# STORAGE_DRIVER=neon

# S3_BUCKET=image-storage

# AWS_ENDPOINT_URL_S3=https://br-....storage....neon.tech

# AWS_REGION=us-east-2

# AWS_ACCESS_KEY_ID=nak_live_...

# AWS_SECRET_ACCESS_KEY=nsk_live_...



# --- Cloudflare R2 (requires credit card — docs/r2-setup.md) ---

# See docs/r2-setup.md. Copy apps/api/.env.r2.example for local R2 testing.

# STORAGE_DRIVER=r2

# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# S3_REGION=auto

# S3_BUCKET=image-storage

# S3_ACCESS_KEY=...

# S3_SECRET_KEY=...



# --- Supabase Storage (S3-compatible — see apps/api/.env.supabase.example) ---

# STORAGE_DRIVER=supabase

# S3_BUCKET=image-storage

# S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3

# S3_REGION=your-project-region

# S3_ACCESS_KEY=...

# S3_SECRET_KEY=...

# SUPABASE_SERVICE_ROLE_KEY=...  (CDN signed URLs for private bucket)
# SUPABASE_BUCKET_PUBLIC=true    (optional; only if Supabase bucket is public)



# --- MinIO (local S3 emulator: pnpm infra:up && pnpm dev:s3) ---

# STORAGE_DRIVER=s3

# S3_ENDPOINT=http://127.0.0.1:9000

# S3_REGION=us-east-1

# S3_BUCKET=image-storage

# S3_ACCESS_KEY=minioadmin

# S3_SECRET_KEY=minioadmin

# S3_USE_PATH_STYLE=true



# --- Auto-tag via Ollama in Docker (optional — see pnpm infra:up && pnpm ollama:setup) ---

# IMAGE_CLASSIFIER=ollama

# OLLAMA_URL=http://127.0.0.1:11435

# OLLAMA_MODEL=phototagger

# AUTO_TAG_ON_UPLOAD=true

# AUTO_TAG_PREFIX=


