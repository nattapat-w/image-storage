# Cloudflare R2 — copy to apps/api/.env for local testing against your bucket
# Production: set these on Render (never commit real secrets)

STORAGE_DRIVER=r2
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=image-storage
S3_ACCESS_KEY=your_r2_access_key_id
S3_SECRET_KEY=your_r2_secret_access_key

HOST=127.0.0.1
PORT=8080
JWT_SECRET=dev-only-change-in-production
FRONTEND_URL=http://localhost:3000
DATABASE_PATH=data/app.db
