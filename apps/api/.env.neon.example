# Neon Object Storage — copy to apps/api/.env.neon and fill credentials
# Run: pnpm dev:neon

ENABLE_DEV_TOOLS=true

STORAGE_DRIVER=neon
S3_BUCKET=image-storage

AWS_ENDPOINT_URL_S3=https://br-YOUR-BRANCH.storage.c-4.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=nak_live_...
AWS_SECRET_ACCESS_KEY=nsk_live_...

HOST=127.0.0.1
PORT=8080
JWT_SECRET=dev-only-change-in-production
FRONTEND_URL=http://localhost:3000
DATABASE_PATH=data/app.db
